vault_path: "<VAULT_ROOT>"
inbox_folder: "<INBOX>"   # Written from CONFIG § Folders by install_daemon.py (via generate_vocabulary.py); do not hand-edit — rename the inbox in CONFIG.md and reinstall.
host: "127.0.0.1"
port: 8765

embedding:
  provider: "sentence-transformers"
  model: "sentence-transformers/all-MiniLM-L6-v2"
  device: "cpu"
  cache_dir: "<HOME>/.cache/sentence-transformers"
  batch_size: 32

index:
  path: "<DATA_DIR>/index.db"
  chunk_size_tokens: 500
  chunk_overlap_tokens: 80
  rebuild_on_schema_change: true

watch:
  debounce_seconds: 2.0
  full_rescan_interval_hours: 6
  exclude_paths:
    - "Archive"
    - "<INBOX>/Claude-Conversations"
    - "<INBOX>/Sources"
    - "References/Sources"
    - ".obsidian"
    - ".claude"
    - ".smart-env"
    - ".history"
    - ".trash"
    - ".redteam"

workflow_clustering:
  enabled: true
  algorithm: "louvain"
  min_cluster_size: 2
  jaccard_threshold: 0.15
  recluster_interval_hours: 24
  auto_label_with_haiku: false

mcp:
  transport: "http"

lifecycle:
  idle_shutdown_minutes: 120   # exit cleanly after this long without a request; 0 = run forever (the session-start hook relaunches it on demand)

logging:
  level: "INFO"
  log_path: "<DATA_DIR>/daemon.log"
