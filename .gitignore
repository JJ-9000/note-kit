# Per-user plugin settings (written by Obsidian at runtime)
plugin/note-kit-ui/data.json

# Dev-loop runbook + CDP helper — holds machine-local absolute paths, kept private
plugin/note-kit-ui/dev/

# OS noise
.DS_Store
Thumbs.db

# Sync logs written when sync_config runs inside the repo working tree
/Archive/
/99-Archive/
